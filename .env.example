# OpenSpawner Configuration
# Copy this file to .env and adjust values as needed
# cp .env.example .env

# ============================================================
# REQUIRED - Must be set before first run
# ============================================================

# Flask session secret - generate with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-in-production

# Your domain (use 'localhost' for local development)
BASE_DOMAIN=localhost

# Subdomain for the spawner (e.g. coder -> coder.example.com)
SPAWNER_SUBDOMAIN=coder

# ============================================================
# TRAEFIK - Only needed for production deployment
# ============================================================

# Set to 'true' for production with Traefik reverse proxy
# When 'false' (default for localhost), ports are exposed directly
TRAEFIK_ENABLED=false

# Traefik Docker network (must exist for production)
# TRAEFIK_NETWORK=web

# Traefik certificate resolver name (from your traefik.yml)
# TRAEFIK_CERTRESOLVER=lets-encrypt

# Traefik entrypoint for HTTPS
# TRAEFIK_ENTRYPOINT=websecure

# Endpoint Traefik calls to check that a request to a user container comes
# from its owner (forwardAuth). The default uses the backend's network alias
# from docker-compose.prod.yml.
# FORWARD_AUTH_URL=http://openspawner-backend:5000/api/auth/forward

# Every user gets an own Docker network, shared only with Traefik: no access
# to other users, the backend or other apps on the Traefik network. Each user
# takes a /28 block of this range; it must not overlap other networks or LANs.
# USER_NETWORK_SUBNET=10.213.0.0/16

# Egress firewall: user containers reach the public internet, but not the host,
# the LAN or cloud metadata. Off by default, it changes the host's firewall.
# Needs Docker's iptables backend. Details in docker-compose.prod.yml.
# COMPOSE_PROFILES=firewall

# Private addresses user containers may still reach, comma-separated CIDRs
# (e.g. a school proxy). The DNS servers of the host are allowed automatically.
# EGRESS_ALLOW=10.1.2.3/32

# Traefik container attached to the user networks. Auto-detected (the Traefik
# container on TRAEFIK_NETWORK); set it only if detection fails.
# TRAEFIK_CONTAINER=dokploy-traefik

# ============================================================
# DOCKER - Template Configuration
# ============================================================

# Docker socket path (default works for Linux and Docker Desktop)
DOCKER_HOST=unix:///var/run/docker.sock

# Legacy template image (fallback for single-template mode)
USER_TEMPLATE_IMAGE=template-nginx:latest

# Dynamic template list (semicolon-separated)
# Format: image1:tag;image2:tag;image3:tag
#
# Only templates listed here are built by install.sh.
# Template metadata (names, descriptions) is loaded from templates.json.
#
# Available templates:
#   Anwendungen (Software):
#   - template-nginx:latest        (Nginx)
#   - template-nextjs:latest       (Next.js Production)
#   - template-dictionary:latest   (Dictionary App)
#   - template-vcoder:latest       (ESP8266 IDE)
#   - template-vscode:latest       (VS Code)
#   - template-dev:latest          (KI-Coding: VS Code + Copilot, Claude Code, Codex, OpenCode)
#   - template-office:latest       (LibreOffice)
#   Betriebssysteme:
#   - template-linuxmint:latest    (Linux Mint XFCE)
#   Datenbanken:
#   - template-mariadb:latest      (MariaDB + phpMyAdmin)
USER_TEMPLATE_IMAGES="template-nginx:latest;template-nextjs:latest;template-dictionary:latest;template-vcoder:latest;template-vscode:latest;template-dev:latest;template-office:latest;template-linuxmint:latest;template-mariadb:latest"

# Templates the build-templates service builds on every deploy (compose profile):
# "default" = core set (nginx, vcoder, dev, mariadb), "build" = full catalog
# TEMPLATE_PROFILE=default

# ============================================================
# RESOURCES - Container Limits
# ============================================================

# RAM limit per user container
DEFAULT_MEMORY_LIMIT=512m

# CPU quota (50000 = 0.5 CPU, 100000 = 1 CPU)
DEFAULT_CPU_QUOTA=50000

# ============================================================
# JWT - Authentication
# ============================================================

# JWT secret (uses SECRET_KEY if not set)
# JWT_SECRET_KEY=

# JWT token validity in seconds (default: 8 hours). The token also opens the
# user's containers, so keep it longer than a school day's lessons.
JWT_ACCESS_TOKEN_EXPIRES=28800

# ============================================================
# CORS - Cross-Origin Resource Sharing
# ============================================================

# Allowed CORS origins (comma-separated)
# Only set if you need additional origins beyond localhost
# CORS_ORIGINS=https://coder.example.com,http://localhost:3000

# ============================================================
# OPTIONAL - Logging and Debugging
# ============================================================

# Spawner port (internal, for direct access)
SPAWNER_PORT=5000

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Container lifecycle management (auto-stop, auto-cleanup)
# Idle timeout: containers are stopped after this many seconds of inactivity
CONTAINER_IDLE_TIMEOUT=3600

# Stale timeout: stopped containers are removed (volumes preserved) after this many seconds
CONTAINER_STALE_TIMEOUT=604800

# How often the reaper checks for idle/stale containers (seconds)
REAPER_INTERVAL=60

# Container creation timeout in seconds
CONTAINER_CREATE_TIMEOUT=10

# ============================================================
# PASSWORDLESS AUTH - Magic Links
# ============================================================

# Magic link token validity in seconds (default: 15 minutes)
MAGIC_LINK_TOKEN_EXPIRY=900

# Max magic links per email address per hour (rate limiting)
MAGIC_LINK_RATE_LIMIT=3

# ============================================================
# EMAIL - Magic Links and Notifications (optional for local dev)
# ============================================================

# SMTP server configuration
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true

# Frontend URL for email links
# FRONTEND_URL=https://coder.example.com

# ============================================================
# DEBUG & ADMINISTRATION
# ============================================================

# Debug token for admin API
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
DEBUG_TOKEN=
